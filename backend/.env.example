# Copy to .env (never commit it). Read by openpersona-cloud and the Lambda function.

# Registry database (Postgres; we use Neon). OPENPERSONA_REGISTRY_URL and DATABASE_URL also work.
NEON_DB_URL=
# OPENPERSONA_REGISTRY_SCHEMA=openpersona

# Model provider keys.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Models, as "provider:model".
OPENPERSONA_CHAT_MODEL=openrouter:typesafe/jev-router
# Set to "off" to run retrieval lexical + graph only.
OPENPERSONA_EMBED_MODEL=openai:text-embedding-3-small

# Optional operator key with every scope, next to the customer keys in the database.
OPENPERSONA_API_KEY=
# Browser origins allowed to call the API, comma-separated.
OPENPERSONA_CORS_ORIGINS=
