# /etc/openpersona/openpersona.env  (chmod 600, owned by root)
NEON_DB_URL=postgresql://...-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENPERSONA_CHAT_MODEL=openrouter:typesafe/jev-router
OPENPERSONA_EMBED_MODEL=openai:text-embedding-3-small
# Optional operator key with every scope, next to the customer keys:
OPENPERSONA_API_KEY=
# Frontend origins (Vercel / Cloudflare Pages), comma-separated:
OPENPERSONA_CORS_ORIGINS=
